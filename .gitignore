# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
dist/
/build/
.vite/
*.tsbuildinfo

# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Secrets scanner output — contains fragments of live credentials
gitleaks-report.sarif
trufflehog-report.sarif
.secrets.baseline

# Scan artifacts and caches
*.sarif
sarif/
corpus/output/
corpus/results/

# Run records — the same reason as *.sarif above. Each runs/<run_id>_<checker>.json carries a
# Finding.evidence verbatim, and for the secrets checker that quote is a matched credential
# fragment. Anchored to backend/ so a source directory named runs/ elsewhere is still tracked.
/backend/runs/

# Pinned scanner binaries, fetched and checksum-verified locally, never committed.
# A vendored 8MB executable from a third-party release is not something a source repo should
# carry, and an unverified one is worse than none. See SYSTEM_LEDGER.md K14 for the fetch steps.
/backend/.tools/

# Local databases
# Anchored to the repo root on purpose. An unanchored `data/` matches at ANY depth and would
# silently exclude backend/app/data/ or dashboard/src/data/ — a findings store is exactly the
# kind of directory this project will grow, and it would vanish with no error.
*.db
*.sqlite3
/data/

# Verification artifacts that must be regenerated, not committed
verification/
eval-output/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
