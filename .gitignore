# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
dist/
/build/
.vite/
*.tsbuildinfo

# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Secrets scanner output — contains fragments of live credentials
gitleaks-report.sarif
trufflehog-report.sarif
.secrets.baseline

# Scan artifacts and caches
*.sarif
sarif/
corpus/output/
corpus/results/

# Local databases
# Anchored to the repo root on purpose. An unanchored `data/` matches at ANY depth and would
# silently exclude engine/app/data/ or dashboard/src/data/ — a findings store is exactly the
# kind of directory this project will grow, and it would vanish with no error.
*.db
*.sqlite3
/data/

# Verification artifacts that must be regenerated, not committed
verification/
eval-output/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
